{
	"name": "doctorcre-engine",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "biome ci",
		"types": "wrangler types && tsc --noEmit",
		"dead": "knip",
		"test": "node --test \"src/**/*.test.ts\"",
		"build": "wrangler deploy --dry-run --outdir dist",
		"check": "npm run lint && npm run dead && node scripts/database-check.ts && npm run build",
		"fix": "biome check --write",
		"schema:drift": "node scripts/schema-drift.ts",
		"compare": "node scripts/compare-deals.ts",
		"types:db": "kysely-codegen --dialect postgres --include-pattern \"public.*\" --date-parser string --type-mapping '{\"timestamp\":\"string\",\"timestamptz\":\"string\"}' --out-file src/database.d.ts",
		"types:next": "kysely-codegen --dialect postgres --include-pattern \"next.*\" --default-schema next --date-parser string --type-mapping '{\"timestamp\":\"string\",\"timestamptz\":\"string\"}' --out-file src/next-database.d.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.2",
		"aws4fetch": "1.0.20",
		"better-auth": "1.7.27",
		"hono": "4.13.18",
		"jose": "6.2.17",
		"kysely": "0.29.8",
		"pg": "8.23.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"knip": "6.45.1",
		"kysely-codegen": "0.20.0",
		"typescript": "7.0.2",
		"wrangler": "4.160.1"
	}
}
